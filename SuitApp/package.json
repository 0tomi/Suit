{
  "name": "suitapp",
  "productName": "SuitAPP",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "build:electron": "npm run build && electron-builder",
    "build:electron:dir": "npm run build && electron-builder --dir",
    "build:electron:win": "npm run build && electron-builder --win",
    "diagnose:packaging": "npm list -a --include prod --include optional --omit dev --json --long --silent --loglevel=error",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && electron .",
    "dev:electron": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "postinstall": "electron-rebuild -w better-sqlite3 && node ./scripts/patch-uncontrollable-jsx-runtime.mjs",
    "test": "playwright test",
    "test:e2e": "node ./scripts/run-playwright-battery.mjs all",
    "test:e2e:all": "node ./scripts/run-playwright-battery.mjs all",
    "test:e2e:bg": "npm run test:e2e",
    "test:e2e:raw": "playwright test",
    "test:e2e:changed": "node ./scripts/run-playwright-battery.mjs changed",
    "test:e2e:agenda": "node ./scripts/run-playwright-battery.mjs agenda",
    "test:e2e:notifications": "node ./scripts/run-playwright-battery.mjs notifications",
    "test:e2e:data-cache": "node ./scripts/run-playwright-battery.mjs data-cache",
    "test:e2e:workspace": "node ./scripts/run-playwright-battery.mjs workspace",
    "test:e2e:shell-settings": "node ./scripts/run-playwright-battery.mjs shell-settings",
    "test:e2e:notifications:visual": "npm run build && cross-env NODE_ENV=production RUN_VISUAL_NOTIFICATION_TEST=1 playwright test --config=playwright.visual.config.js --headed",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@tiptap/extension-image": "^3.20.1",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "react-photo-album": "^3.5.1",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-bubble-menu": "^3.20.0",
    "@tiptap/extension-character-count": "^3.20.1",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.0",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-mention": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-subscript": "^3.20.1",
    "@tiptap/extension-superscript": "^3.20.1",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-typography": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "electron": "^40.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "sileo": "^0.1.5",
    "tailwindcss": "^4.1.18",
    "tippy.js": "^6.3.7",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "tar": "7.5.11"
  },
  "build": {
    "appId": "com.suitapp.desktop",
    "productName": "SuitAPP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico"
    }
  }
}
