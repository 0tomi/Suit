     <!-- ===================== TAB APLICACION ===================== -->
     <widget class="QWidget" name="AplicacionSettings">
      <attribute name="title">
       <string>Aplicación</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_aplicacion">
       <item>
        <widget class="QGroupBox" name="grpModoInicio">
