     <!-- ===================== TAB PHP ===================== -->
     <widget class="QWidget" name="PhpSettings">
      <attribute name="title">
       <string>PHP</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_php">
       <item>
        <widget class="QGroupBox" name="grpExtensiones">
         <property name="title"><string>Extensiones</string></property>
         <layout class="QVBoxLayout" name="verticalLayout_ext">
          <item>
           <widget class="QScrollArea" name="scrollAreaExtensiones">
            <property name="widgetResizable">
             <bool>true</bool>
            </property>
