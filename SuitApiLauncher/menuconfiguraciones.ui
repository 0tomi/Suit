         <layout class="QVBoxLayout" name="verticalLayout_timeouts">
          <item>
           <widget class="QLabel" name="lblTimeoutsDesc">
            <property name="text">
             <string>Cuando está desactivado, el cierre espera indefinidamente hasta que el proceso termine. Al activar, se fuerza el cierre si el proceso no terminó en el tiempo indicado.</string>
            </property>
            <property name="wordWrap"><bool>true</bool></property>
            <property name="styleSheet"><string notr="true">color: #666666; font-size: 11px;</string></property>
           </widget>
          </item>
          <item>
