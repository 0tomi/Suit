              <rect><x>0</x><y>0</y><width>600</width><height>280</height></rect>
             </property>
            </widget>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpRecursos">
         <property name="title"><string>Límites de recursos</string></property>
         <layout class="QFormLayout" name="formLayoutRecursos">
          <item row="0" column="0">
           <widget class="QLabel" name="lblMaxExecTime">
            <property name="text"><string>Tiempo máx. de ejecución:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout" name="horizontalLayout_execTime">
            <item>
             <widget class="QSpinBox" name="spnMaxExecTime">
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>3600</number></property>
              <property name="value"><number>30</number></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblSegundos">
              <property name="text"><string>segundos (0 = sin límite)</string></property>
             </widget>
